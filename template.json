{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Transform": "AWS::Serverless-2016-10-31",
    "Description": "InboxFlow IMAP Sync Lambda Function",
    "Resources": {
      "ImapSyncFunction": {
        "Type": "AWS::Serverless::Function",
        "Properties": {
          "CodeUri": "inboxflow-imap-sync/",
          "Handler": "imap_sync.lambda_handler",
          "Runtime": "python3.9",
          "Timeout": 900,
          "Environment": {
            "Variables": {
              "DB_URL": "postgresql://user:pass@localhost:5432/inboxflow",
              "EMAIL_SERVER": "imap.mail.yahoo.com",
              "EMAIL_USER": "you@example.com",
              "EMAIL_PASSWORD": "REDACTED_APP_PASSWORD"
            }
          }
        }
      }
    }
  }